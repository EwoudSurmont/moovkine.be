---
import navData from "../data/navData";
import { Image } from "astro:assets";
import AppointmentDialog from "./AppointmentDialog.astro";
---

<footer>
  <div
    class="bg-brand-green mx-auto px-16 py-16 md:grid md:grid-cols-3 md:gap-x-16 md:items-start"
  >
    <div class="mt-4">
      <p class="text-sm text-white font-bold">Praktijk</p>
      <p class="text-sm text-white">
        Lichterveldestraat 145<br />8610 Kortemark
      </p>
      <p class="text-sm text-white font-bold mt-4">Contact</p>
      <a class="block text-sm text-white underline mb-4" href="tel:+32475277353"
        >0475 27 73 53</a
      >
      <AppointmentDialog />
    </div>
    <a class="self-center hidden md:block" href="/"
      ><Image
        src="/img/trigger.png"
        alt="logo trigger"
        width="128"
        height="128"
        class="object-contain h-24 w-full"
      /></a
    >
    <nav class="hidden md:block">
      <div class="text-sm block text-right">
        {
          navData.map((page) => (
            <a
              rel="prefetch"
              class="block mt-4 text-white font-bold hover:underline"
              data-navlink
              href={page.path}
            >
              {page.name}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
  <div class="mx-auto py-4 text-center text-xs">
    <p>
      Made with <span class="font-emoji">&#10084;</span> by <a
        class="underline"
        href="https://ewoudsurmont.be">ewoudsurmont.be</a
      >
    </p>
  </div>
</footer>
